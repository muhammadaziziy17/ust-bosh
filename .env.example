APP_NAME=UstBosh
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=uz
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=uz_UZ
APP_TIMEZONE=Asia/Tashkent

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS ishlatilganda SESSION_SECURE_COOKIE=true qiling
SESSION_SECURE_COOKIE=false

# Ngrok/Herd kabi lokal proksi ortida ishlaganda X-Forwarded-* headerlariga
# ishoniladigan manzillar (vergul bilan). Bo'sh bo'lsa proksi ishonchsiz hisoblanadi.
TRUSTED_PROXIES=127.0.0.1,::1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# Excel hisoboti chegaralari (katta davrda xotira va fayl hajmini cheklaydi)
REPORT_MAX_EXPORT_SALES=5000
REPORT_MAX_EXPORT_PRODUCTS=500
REPORT_MAX_EXPORT_LOW_STOCK=500

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# SMTP ishlatish uchun quyidagi misolni to'ldiring va MAIL_MAILER=smtp qiling:
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USERNAME=your@email.com
# MAIL_PASSWORD=your_app_password

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Super Admin (admin panelga kirish)
# Iltimos, kuchli parol qo'ying va uni hech qachon repoga commit qilmang.
# Birinchi admin login paytida users jadvaliga hash'langan holda yoziladi.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
